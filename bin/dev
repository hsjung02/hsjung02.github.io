#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SITE_URL="${SITE_URL:-http://localhost:8080}"
STARTUP_TIMEOUT_SECONDS="${STARTUP_TIMEOUT_SECONDS:-300}"

if ! command -v docker >/dev/null 2>&1; then
    echo "Docker가 설치되어 있지 않습니다. Docker Desktop을 먼저 설치해 주세요." >&2
    exit 1
fi

if ! docker info >/dev/null 2>&1; then
    echo "Docker가 실행 중이 아닙니다. Docker Desktop을 먼저 실행해 주세요." >&2
    exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
    echo "Docker Compose를 사용할 수 없습니다. Docker Desktop 설치를 확인해 주세요." >&2
    exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
    echo "서버 준비 상태를 확인하려면 curl이 필요합니다." >&2
    exit 1
fi

cd "$PROJECT_ROOT"

echo "Jekyll 개발 서버를 빌드하고 시작합니다..."
docker compose up --build --detach

echo "$SITE_URL 이 응답할 때까지 기다립니다..."
deadline=$((SECONDS + STARTUP_TIMEOUT_SECONDS))

until curl --silent --fail --output /dev/null "$SITE_URL"; do
    if (( SECONDS >= deadline )); then
        echo "${STARTUP_TIMEOUT_SECONDS}초 안에 서버가 준비되지 않았습니다." >&2
        echo "최근 컨테이너 로그:" >&2
        docker compose logs --tail=100 jekyll >&2
        exit 1
    fi

    sleep 2
done

echo "서버가 준비되었습니다: $SITE_URL"

if command -v open >/dev/null 2>&1; then
    open "$SITE_URL"
else
    echo "브라우저에서 $SITE_URL 을 열어 주세요."
fi

echo "종료할 때는 다음 명령을 실행하세요: docker compose down"
